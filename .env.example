# ==========================================================
#  AllVote — copiez ce fichier en .env puis complétez.
#  .env est ignoré par git : NE LE PARTAGEZ JAMAIS.
# ==========================================================

# dev = tables créées automatiquement | prod = Flyway
ALLVOTE_SPRING_PROFILES_ACTIVE=dev
ALLVOTE_PORT=8081

# --- Base de données (utilisée aussi par docker-compose) ---
ALLVOTE_DB_URL=jdbc:postgresql://localhost:5434/allvote
ALLVOTE_DB_USER=allvote
ALLVOTE_DB_PASSWORD=

# Données de démonstration (2 organisateurs, événements, candidats) — dev uniquement
ALLVOTE_DONNEES_DEMO=true

# --- Sécurité ---
# Générer : openssl rand -base64 48
ALLVOTE_JWT_SECRET=
ALLVOTE_JWT_EXPIRATION_MINUTES=120

# Compte SUPER-ADMIN créé au premier démarrage (mot de passe : 12 caractères minimum)
ALLVOTE_SUPERADMIN_EMAIL=
ALLVOTE_SUPERADMIN_PASSWORD=

# --- URLs ---
ALLVOTE_FRONT_URL=http://localhost:5173
ALLVOTE_PUBLIC_URL=http://localhost:8081
ALLVOTE_CORS_ORIGINS=http://localhost:5173

# --- Paiement ---
ALLVOTE_PAYMENT_MODE=simulated
ALLVOTE_AANGARAA_APP_KEY=

# --- Divers ---
ALLVOTE_STORAGE_DIR=./uploads
ALLVOTE_TRUST_FORWARDED_HEADERS=false
